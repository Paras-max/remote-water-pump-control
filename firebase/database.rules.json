{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        "command": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['commandId', 'command', 'status'])"
        },
        "schedule": {
          ".write": "auth != null"
        },
        "status": {
          ".write": "auth != null || auth.token.firebase.sign_in_provider == 'anonymous'"
        },
        "connection": {
          ".write": "auth != null || auth.token.firebase.sign_in_provider == 'anonymous'"
        },
        "sessions": {
          ".write": "auth != null || auth.token.firebase.sign_in_provider == 'anonymous'"
        },
        "logs": {
          ".write": "auth != null || auth.token.firebase.sign_in_provider == 'anonymous'"
        }
      }
    }
  }
}
